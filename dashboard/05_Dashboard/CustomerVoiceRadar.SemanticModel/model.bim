      {
        "name": "_Measures",
        "columns": [
          {
            "name": "Dummy",
            "dataType": "string",
            "sourceColumn": "Dummy",
            "isHidden": true,
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "_Measures-p",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #table(type table [Dummy = text], {})",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Sales",
            "expression": "SUM ( FactOrders[order_value_sar] )",
            "formatString": "#,0"
          },
          {
            "name": "Orders",
            "expression": "COUNTROWS ( FactOrders )",
            "formatString": "#,0"
          },
          {
            "name": "Customers",
            "expression": "CALCULATE ( DISTINCTCOUNT ( FactOrders[customer_id] ), FactOrders[customer_id] <> \"NO_CUSTOMER\" )",
            "formatString": "#,0"
          },
          {
            "name": "Avg Order Value",
            "expression": "DIVIDE ( [Total Sales], [Orders] )",
            "formatString": "#,0"
          },
          {
            "name": "Profit",
            "expression": "SUM ( FactOrders[profit_sar] )",
            "formatString": "#,0"
          },
          {
            "name": "Shipped Orders",
            "expression": "CALCULATE ( [Orders], FactOrders[order_status] IN { \"Delivered\", \"Returned\" } )",
            "formatString": "#,0"
          },
          {
            "name": "Late Orders",
            "expression": "CALCULATE ( [Orders], FactOrders[is_late] = 1 )",
            "formatString": "#,0"
          },
          {
            "name": "Late %",
            "expression": "DIVIDE ( [Late Orders], [Shipped Orders] )",
            "formatString": "0.0%"
          },
          {
            "name": "Avg Delivery Days",
            "expression": "CALCULATE ( AVERAGE ( FactOrders[delivery_days] ), FactOrders[order_status] IN { \"Delivered\", \"Returned\" } )",
            "formatString": "0.00"
          },
          {
            "name": "Return %",
            "expression": "DIVIDE ( CALCULATE ( [Orders], FactOrders[order_status] = \"Returned\" ), [Orders] )",
            "formatString": "0.0%"
          },
          {
            "name": "Cancel %",
            "expression": "DIVIDE ( CALCULATE ( [Orders], FactOrders[order_status] = \"Cancelled\" ), [Orders] )",
            "formatString": "0.0%"
          },
          {
            "name": "Reviews",
            "expression": "COUNTROWS ( FactReviews )",
            "formatString": "#,0"
          },
          {
            "name": "Avg Rating",
            "expression": "AVERAGE ( FactReviews[rating] )",
            "formatString": "0.00"
          },
          {
            "name": "Complaints",
            "expression": "SUM ( FactReviews[is_complaint] )",
            "formatString": "#,0"
          },
          {
            "name": "Negative Text %",
            "expression": "DIVIDE ( SUM ( FactReviews[is_negative_text] ), [Reviews] )",
            "formatString": "0.0%"
          },
          {
            "name": "Complaint Cost",
            "expression": "CALCULATE ( [Total Sales], FactOrders[has_complaint] = 1 )",
            "formatString": "#,0"
          },
          {
            "name": "Topic Mentions",
            "expression": "COUNTROWS ( ReviewTopics )",
            "formatString": "#,0"
          },
          {
            "name": "Negative Mentions",
            "expression": "CALCULATE ( [Topic Mentions], ReviewTopics[text_sentiment] = \"Negative\" )",
            "formatString": "#,0"
          },
          {
            "name": "Avg Health Score",
            "expression": "AVERAGE ( DimCustomer[health_score] )",
            "formatString": "0.0"
          },
          {
            "name": "At Risk Customers",
            "expression": "CALCULATE ( COUNTROWS ( DimCustomer ), DimCustomer[health_band] = \"معرّض للخسارة\" )",
            "formatString": "#,0"
          },
          {
            "name": "Revenue at Risk",
            "expression": "CALCULATE ( SUM ( DimCustomer[revenue_sar] ), DimCustomer[health_band] = \"معرّض للخسارة\" )",
            "formatString": "#,0"
          },
          {
            "name": "Customer Revenue",
            "expression": "SUM ( DimCustomer[revenue_sar] )",
            "formatString": "#,0"
          },
          {
            "name": "Anomaly Count",
            "expression": "COUNTROWS ( Anomalies )",
            "formatString": "#,0"
          },
          {
            "name": "High Severity Anomalies",
            "expression": "CALCULATE ( [Anomaly Count], Anomalies[severity] = \"عالية\" )",
            "formatString": "#,0"
          },
          {
            "name": "Review Anomalies",
            "expression": "CALCULATE ( [Anomaly Count], Anomalies[source] = \"التعليقات\" )",
            "formatString": "#,0"
          },
          {
            "name": "Rows Before",
            "expression": "SUM ( DataQuality[rows_before] )",
            "formatString": "#,0"
          },
          {
            "name": "Rows After",
            "expression": "SUM ( DataQuality[rows_after] )",
            "formatString": "#,0"
          },
          {
            "name": "Missing Before",
            "expression": "SUM ( DataQuality[missing_before] )",
            "formatString": "#,0"
          },
          {
            "name": "Missing After",
            "expression": "SUM ( DataQuality[missing_after] )",
            "formatString": "#,0"
          },
          {
            "name": "Rows Removed",
            "expression": "[Rows Before] - [Rows After]",
            "formatString": "#,0"
          },
          {
            "name": "Cleaning Actions",
            "expression": "COUNTROWS ( CleaningLog )",
            "formatString": "#,0"
          }
        ]
      }
    ],
    "relationships": [
